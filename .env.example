# Server-side (Vercel / API routes) — required for automatic email on completion
RESEND_API_KEY=
# After verifying your domain in Resend, set a verified sender (required in production):
# RESEND_FROM_EMAIL=Angel Learning Center <info@angellearningcenter.com>

# Optional overrides (defaults shown)
# RESEND_FROM_EMAIL=Angel Learning Center <info@angellearningcenter.com>
# ENROLLMENT_CC_EMAIL=info@angellearningcenter.com
# ENROLLMENT_NOTIFICATION_EMAIL=info@angellearningcenter.com  # fallback if center inbox missing

# Client-side display fallback for center inbox on done screen
# VITE_ENROLLMENT_NOTIFICATION_EMAIL=info@angellearningcenter.com

# Local dev (npm run dev): Vite runs api/submit-enrollment.js on your machine (not the Vercel proxy).
# RESEND_API_KEY is required in .env for local completion emails to send.
# VITE_LOCAL_DEV_NOTIFICATION_EMAIL=dev4@sioxglobal.com
# DEV_NOTIFICATION_EMAIL=dev4@sioxglobal.com
# VITE_API_PROXY_TARGET=https://angel-learning-enrollment.vercel.app

# Server override when VERCEL_ENV is not production (optional)
# DEV_NOTIFICATION_EMAIL=dev4@sioxglobal.com
